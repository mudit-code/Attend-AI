  tr:nth-child(even) { background-color: #f8fafc; }
  .badge { background-color: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 9pt; }
  .pwd { font-family: Consolas, monospace; font-weight: bold; color: #0f172a; background: #e0f2fe; padding: 2px 6px; border-radius: 3px; }
  .note { background-color: #fffbeb; border-left: 4px solid #f59e0b; padding: 10px 14px; margin: 15px 0; font-size: 10.5pt; }
</style>
</head>
