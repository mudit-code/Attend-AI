// AttendAI — Prisma Schema
// PostgreSQL database with 24 tables
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ACADEMIC YEAR
// =============================================
model AcademicYear {
  id        Int       @id @default(autoincrement())
  label     String    // e.g. "2026-27"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())

  departments  Department[]
  courses      Course[]
  sections     Section[]
  timetableSlots TimetableSlot[]

  @@map("academic_years")
}

// =============================================
// USERS
// =============================================
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher      Teacher?
  student      Student?
  parent       Parent?
  devices      Device[]
  notifications Notification[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  institutionalFeedbacks InstitutionalFeedback[]
  gradedAssignmentSubmissions AssignmentSubmission[] @relation("AssignmentGradedBy")
  signedOffAssignmentSubmissions AssignmentSubmission[] @relation("AssignmentSignedOffBy")

  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  HOD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// =============================================
// DEPARTMENT, COURSE, SECTION
// =============================================
model Department {
  id             Int          @id @default(autoincrement())
  name           String
  code           String       @unique
  academicYearId Int
  hodId          Int?         // teacher id

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  courses        Course[]
  teachers       Teacher[]

  @@map("departments")
}

model Course {
  id             Int          @id @default(autoincrement())
  name           String
  code           String       @unique
  durationYears  Int          @default(3)
  departmentId   Int
  academicYearId Int

  department     Department   @relation(fields: [departmentId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  sections       Section[]

  @@map("courses")
}

model Section {
  id             Int          @id @default(autoincrement())
  name           String       // e.g. "3rd Year A"
  year           Int          // 1, 2, 3 etc.
  courseId       Int
  academicYearId Int
  isFaceAttendanceEnabled Boolean @default(true)

  course         Course       @relation(fields: [courseId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  students       Student[]
  timetableSlots TimetableSlot[]
  teacherSubjects TeacherSubject[]
  attendanceSessions AttendanceSession[]
  assignments Assignment[]

  @@map("sections")
}

// =============================================
// TEACHER & STUDENT
// =============================================
model Teacher {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  employeeCode String     @unique
  departmentId Int
  isClassTeacher Boolean  @default(false)
  classTeacherSectionId Int?

  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  subjects     TeacherSubject[]
  sessions     AttendanceSession[]
  leaveRequests TeacherLeaveRequest[]
  assignments  Assignment[]
  mentorGatePasses GatePass[] @relation("GatePassMentor")

  @@map("teachers")
}

model Student {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  rollNo     String  @unique
  sectionId  Int
  parentId   Int?
  faceDescriptor Float[] @default([])
  faceRegisteredAt DateTime?

  user       User    @relation(fields: [userId], references: [id])
  section    Section @relation(fields: [sectionId], references: [id])
  parent     Parent? @relation(fields: [parentId], references: [id])
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  correctionRequests CorrectionRequest[]
  attendanceSummaries AttendanceSummary[]
  internalMarks      InternalMark[]
  assignmentSubmissions AssignmentSubmission[]
  clearanceStatus    ClearanceStatus?
  libraryRecords     LibraryRecord[]
  grievanceTickets   GrievanceTicket[]
  driveRegistrations DriveRegistration[]
  gatePasses         GatePass[]

  @@map("students")
}

model Parent {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
  children Student[]

  @@map("parents")
}

// =============================================
// SUBJECT & TIMETABLE
// =============================================
model Subject {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  teacherSubjects TeacherSubject[]
  attendanceSessions AttendanceSession[]
  assignments Assignment[]

  @@map("subjects")
}

model TeacherSubject {
  id        Int @id @default(autoincrement())
  teacherId Int
  subjectId Int
  sectionId Int

  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@unique([teacherId, subjectId, sectionId])
  @@map("teacher_subjects")
}

model TimetableSlot {
  id             Int          @id @default(autoincrement())
  sectionId      Int
  subjectId      Int
  teacherId      Int
  dayOfWeek      Int          // 1=Mon, 7=Sun
  period         Int          // 1-8
  startTime      String       // "09:00"
  endTime        String       // "09:55"
  roomNo         String?      // e.g. "302", "Lab-A"
  academicYearId Int

  section        Section      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([sectionId, dayOfWeek, period, academicYearId])
  @@map("timetable_slots")
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
  name String
  type String   // "national" | "college" | "exam"

  @@map("holidays")
}

// =============================================
// ATTENDANCE
// =============================================
model AttendanceSession {
  id          String   @id @default(uuid())
  teacherId   Int
  sectionId   Int
  subjectId   Int
  date        DateTime @db.Date
  period      Int
  locked      Boolean  @default(false)
  lockedAt    DateTime?
  faceWindowActive Boolean @default(false)
  faceWindowExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  section     Section  @relation(fields: [sectionId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  records     AttendanceRecord[]
  conflicts   AttendanceConflict[] @relation("SessionConflicts")
  conflictsWith AttendanceConflict[] @relation("OtherSessionConflicts")
  correctionRequests CorrectionRequest[]

  @@unique([sectionId, subjectId, date, period])
  @@index([sectionId, date])
  @@index([teacherId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String          @id @default(uuid())
  sessionId   String
  studentId   Int
  status      AttendanceStatus
  method      MarkingMethod   @default(MANUAL)
  clientTs    DateTime        // timestamp from device
  receivedAt  DateTime        @default(now())
  changeSeq   BigInt?         // change_log reference

  session     AttendanceSession @relation(fields: [sessionId], references: [id])
  student     Student           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, sessionId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  P   // Present
  A   // Absent
  L   // Late
  LV  // Leave
  OD  // On Duty
}

enum MarkingMethod {
  MANUAL
  QR
  FACE
}

model AttendanceConflict {
  id            Int      @id @default(autoincrement())
  sessionId     String
  otherSessionId String
  status        String   @default("pending") // pending | resolved
  resolvedBy    Int?
  resolvedAt    DateTime?
  notes         String?

  session       AttendanceSession @relation("SessionConflicts", fields: [sessionId], references: [id])
  otherSession  AttendanceSession @relation("OtherSessionConflicts", fields: [otherSessionId], references: [id])

  @@map("attendance_conflicts")
}

// Nightly summary table — fast dashboard queries
model AttendanceSummary {
  id          Int      @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  month       Int      // 1-12
  year        Int
  totalClasses Int     @default(0)
  present      Int     @default(0)
  absent       Int     @default(0)
  late         Int     @default(0)
  leave        Int     @default(0)
  onDuty       Int     @default(0)
  percentage   Float   @default(0)
  updatedAt    DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, subjectId, month, year])
  @@map("attendance_summary")
}

// =============================================
// ATTENDANCE RULES (admin configurable)
// =============================================
model AttendanceRule {
  id                   Int     @id @default(autoincrement())
  minPercent           Float   @default(75)
  lateGraceMinutes     Int     @default(10)
  editWindowHours      Int     @default(24)
  countLeaveAsPresent  Boolean @default(false)
  updatedAt            DateTime @updatedAt

  @@map("attendance_rules")
}

// =============================================
// LEAVE
// =============================================
model LeaveRequest {
  id          String      @id @default(uuid())
  studentId   Int
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  type        LeaveType
  reason      String
  documentUrl String?
  status      LeaveStatus @default(PENDING)
  decidedBy   Int?
  decisionNote String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])

  @@map("leave_requests")
}

enum LeaveType {
  MEDICAL
  PERSONAL
  EVENT
  OD
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// =============================================
// CORRECTION REQUEST (student requests fix)
// =============================================
model CorrectionRequest {
  id              String            @id @default(uuid())
  studentId       Int
  sessionId       String
  requestedStatus AttendanceStatus
  reason          String
  documentUrl     String?
  status          CorrectionStatus  @default(PENDING)
  decidedBy       Int?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student         Student           @relation(fields: [studentId], references: [id])
  session         AttendanceSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])  // max 1 pending per session
  @@map("correction_requests")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================
// SYNC
// =============================================
model ChangeLog {
  changeSeq   BigInt  @id @default(autoincrement())
  entity      String  // "student" | "leave" | "timetable" | "attendance"
  entityId    String
  op          String  // "upsert" | "delete"
  sectionId   Int?
  createdAt   DateTime @default(now())

  @@index([sectionId, changeSeq])
  @@map("change_log")
}

// =============================================
// DEVICES (QR binding + push tokens)
// =============================================
model Device {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceId    String   @unique  // client-generated fingerprint
  pushToken   String?
  platform    String?  // "android" | "ios" | "web"
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("devices")
}

// =============================================
// NOTIFICATIONS
// =============================================
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  channel   String   // "sms" | "push" | "email" | "inapp"
  type      String   // "low_attendance" | "leave_decision" | "absent" | "correction"
  payload   Json
  status    String   @default("pending")  // pending | sent | failed
  attempts  Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("notifications")
}

// =============================================
// AUDIT LOG (append-only, never edit/delete)
// =============================================
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  action    String   // "mark_attendance" | "edit_record" | "unlock" | "approve_leave"
  entity    String   // "attendance_session" | "leave_request" | "correction_request"
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// =============================================
// INTERNAL MARKS (Sessionals / Assignments)
// =============================================
model InternalMark {
  id         Int      @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  markType   MarkType
  marks      Float
  maxMarks   Float    @default(25)
  enteredBy  Int      // teacher userId
  status     String   @default("DRAFT")  // DRAFT | APPROVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, subjectId, markType])
  @@index([studentId])
  @@map("internal_marks")
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String
  maxMarks    Float    @default(100)
  dueAt       DateTime?
  teacherId   Int
  sectionId   Int
  subjectId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  section     Section  @relation(fields: [sectionId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  submissions AssignmentSubmission[]

  @@index([teacherId, createdAt])
  @@index([sectionId, createdAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id                String                     @id @default(uuid())
  assignmentId      String
  studentId         Int
  driveUrl          String
  status            AssignmentSubmissionStatus @default(SUBMITTED)
  marks             Float?
  feedback          String?
  submittedAt       DateTime                   @default(now())
  gradedAt          DateTime?
  gradedByUserId    Int?
  signedOffAt       DateTime?
  signedOffByUserId Int?

  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedByUser    User?      @relation("AssignmentGradedBy", fields: [gradedByUserId], references: [id], onDelete: SetNull)
  signedOffByUser User?      @relation("AssignmentSignedOffBy", fields: [signedOffByUserId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@map("assignment_submissions")
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
  SIGNED_OFF
}

enum MarkType {
  ASSIGNMENT_1
  ASSIGNMENT_2
  SESSIONAL_1
  SESSIONAL_2
  VIVA
  PRACTICAL
}

// =============================================
// NOTICES (Official Notice Board)
// =============================================
model Notice {
  id         Int            @id @default(autoincrement())
  title      String
  body       String
  category   NoticeCategory
  targetRole String?        // null = all, or "STUDENT" | "TEACHER"
  pdfUrl     String?
  postedBy   Int            // userId
  isActive   Boolean        @default(true)
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([isActive, createdAt])
  @@map("notices")
}

enum NoticeCategory {
  EXAM
  FEE
  HOLIDAY
  EVENT
  DISCIPLINE
  GENERAL
}

// =============================================
// CLEARANCE STATUS (No-Dues)
// =============================================
model ClearanceStatus {
  id           Int      @id @default(autoincrement())
  studentId    Int      @unique
  semester     String   // e.g. "ODD-2026"
  academic     Boolean  @default(false)
  accounts     Boolean  @default(false)
  library      Boolean  @default(false)
  discipline   Boolean  @default(false)
  examUnlocked Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id])

  @@map("clearance_status")
}

// =============================================
// LIBRARY RECORDS
// =============================================
model LibraryRecord {
  id          Int       @id @default(autoincrement())
  studentId   Int
  bookTitle   String
  bookCode    String
  issuedAt    DateTime
  dueDate     DateTime
  returnedAt  DateTime?
  finePerDay  Float     @default(2.0)
  finePaid    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  student     Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("library_records")
}

// =============================================
// GRIEVANCE TICKETS
// =============================================
model GrievanceTicket {
  id          String          @id @default(uuid())
  studentId   Int
  title       String
  description String
  category    GrievanceCategory
  isAnonymous Boolean         @default(false)
  status      TicketStatus    @default(OPEN)
  assignedTo  Int?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  student     Student         @relation(fields: [studentId], references: [id])

  @@index([status])
  @@map("grievance_tickets")
}

enum GrievanceCategory {
  ATTENDANCE
  MARKS
  BEHAVIOR
  FACILITIES
  OTHER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

// =============================================
// PLACEMENT DRIVES
// =============================================
model PlacementDrive {
  id                   Int       @id @default(autoincrement())
  companyName          String
  driveDate            DateTime
  minAttendance        Float     @default(75)
  minCgpa              Float?
  eligibleBranches     String[]
  description          String?
  registrationDeadline DateTime?
  createdAt            DateTime  @default(now())

  registrations DriveRegistration[]

  @@map("placement_drives")
}

model DriveRegistration {
  id           Int            @id @default(autoincrement())
  driveId      Int
  studentId    Int
  isEligible   Boolean
  registeredAt DateTime       @default(now())

  drive        PlacementDrive @relation(fields: [driveId], references: [id])
  student      Student        @relation(fields: [studentId], references: [id])

  @@unique([driveId, studentId])
  @@map("drive_registrations")
}

// =============================================
// TEACHER LEAVE & INSTITUTIONAL FEEDBACK
// =============================================
model TeacherLeaveRequest {
  id           String      @id @default(uuid())
  teacherId    Int
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  type         String      @default("CASUAL") // CASUAL, MEDICAL, DUTY
  reason       String
  documentUrl  String?
  status       LeaveStatus @default(PENDING)
  decidedBy    Int?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teacher      Teacher     @relation(fields: [teacherId], references: [id])

  @@map("teacher_leave_requests")
}

model InstitutionalFeedback {
  id        String   @id @default(uuid())
  userId    Int
  role      Role
  category  String   @default("GENERAL") // ACADEMIC, CURRICULUM, FACILITIES, GENERAL
  subject   String
  message   String
  reply     String?
  replyDate DateTime?
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@map("institutional_feedback")
}

// =============================================
// EXPANDED ERP: EMAIL LOGS & CAMPUS HEALTHCARE
// =============================================
model DefaulterEmailLog {
  id                Int      @id @default(autoincrement())
  recipientEmail    String
  recipientName     String
  rollNo            String
  subjectCode       String
  subjectName       String
  attendancePercent Float
  classesAttended   Int
  totalClasses      Int
  senderName        String
  status            String   @default("SENT") // SENT, QUEUED, FAILED
  createdAt         DateTime @default(now())

  @@map("defaulter_email_logs")
}

model DispensaryVisit {
  id                  Int      @id @default(autoincrement())
  studentRollNo       String
  studentName         String
  doctorName          String
  diagnosis           String
  medicinesPrescribed String
  visitDate           DateTime @default(now())

  @@map("dispensary_visits")
}

model MedicineInventory {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  quantity         Int
  unit             String   @default("Tablets")
  usageDirections  String
  reorderThreshold Int      @default(20)

  @@map("medicine_inventory")
}

// =============================================
// GATE PASS SYSTEM
// =============================================
model GatePass {
  id                 String         @id @default(uuid())
  studentId          Int

  // ── Form Fields ───────────────────────────
  reason             GatePassReason
  reasonOther        String?        // Required when reason = OTHER
  destination        String
  additionalNote     String?
  documentUrl        String?
  outTime            DateTime       // Expected departure
  expectedInTime     DateTime       // Expected return

  // ── Dynamic Mentor (auto-assigned) ────────
  mentorTeacherId    Int?
  mentorAssignMethod String?        // "LIVE_SESSION"|"TIMETABLE_SLOT"|"FIRST_CLASS_TODAY"|"CLASS_TEACHER"

  // ── HOD ───────────────────────────────────
  hodUserId          Int?

  // ── Approval Status ───────────────────────
  mentorStatus       GatePassStatus @default(PENDING)
  hodStatus          GatePassStatus @default(PENDING)
  mentorNote         String?
  hodNote            String?
  mentorDecidedAt    DateTime?
  hodDecidedAt       DateTime?

  // ── QR Code (only after HOD approval) ─────
  qrTokenHash        String?        @unique
  qrExpiresAt        DateTime?
  qrConsumedAt       DateTime?
  actualOutTime      DateTime?
  actualInTime       DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  mentor   Teacher? @relation("GatePassMentor", fields: [mentorTeacherId], references: [id])

  @@index([studentId])
  @@index([mentorTeacherId])
  @@map("gate_passes")
}

enum GatePassStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GatePassReason {
  MEDICAL_EMERGENCY
  DOCTOR_APPOINTMENT
  FAMILY_EMERGENCY
  BANK_WORK
  COURT_LEGAL
  TRAVEL
  PERSONAL
  OTHER
}

