# ================================
# AttendAI Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ================================

# --- App ---
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0

# --- Database ---
DATABASE_URL=postgresql://attendai_user:attendai_pass@localhost:5432/attendai_db

# --- Auth ---
JWT_SECRET=change-me-to-a-very-long-random-256-bit-secret
JWT_REFRESH_SECRET=change-me-to-a-different-very-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- File Storage (Cloudflare R2 / S3-compatible) ---
R2_BUCKET=attendai-files
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- SMS (India DLT) ---
SMS_ENABLED=false
SMS_PROVIDER_KEY=
SMS_SENDER_ID=ATTEND
SMS_DLT_TEMPLATE_ID=

# --- Email (fallback for OTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=AttendAI <noreply@attendai.com>

# --- Monitoring ---
SENTRY_DSN=

# --- Feature Flags (turn on per phase) ---
QR_ENABLED=false
LEAVE_ENABLED=false
NOTIFICATIONS_ENABLED=false
FACE_ENABLED=false
